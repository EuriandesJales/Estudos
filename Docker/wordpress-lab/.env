# Senha do usuário root do MySQL (NUNCA use valores fracos em produção)
MYSQL_ROOT_PASSWORD=Retold-Starry-Diner-Smooth-Morale-Accuracy

# Nome do banco de dados a ser criado automaticamente
MYSQL_DATABASE=wordpress_db

# Usuário do banco de dados que o WordPress usará
MYSQL_USER=EuriandesJales

# Senha segura para o usuário do banco
MYSQL_PASSWORD=Skype-Economy-Cheesy-Spoiler-Parish-Tubular

# As seguintes variáveis são usadas pelo WordPress para se conectar ao banco
WORDPRESS_DB_NAME=wordpress_db
WORDPRESS_DB_USER=EuriandesJales
WORDPRESS_DB_PASSWORD=Skype-Economy-Cheesy-Spoiler-Parish-Tubular

# Endereço do serviço do banco na rede Docker (nome do serviço + porta)
WORDPRESS_DB_HOST=mysql:3306
